# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Sanity (sanity.io/manage > project settings)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Required only for private datasets, draft content, or webhook revalidation.
SANITY_API_READ_TOKEN=
SANITY_WRITE_TOKEN=
SANITY_REVALIDATE_SECRET=

# Chat service, required only when the website chat assistant is enabled.
ANTHROPIC_API_KEY=

# Required only if the existing admin chat route remains enabled.
# Never expose an admin credential using a NEXT_PUBLIC_ variable in production.
ADMIN_PASSWORD=

# Optional: only add when Vercel Blob is actually used by code.
BLOB_READ_WRITE_TOKEN=

# Optional: only add when NextAuth/Auth.js is added to the application.
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
